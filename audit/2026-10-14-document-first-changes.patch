+<!doctype html><html lang="en"><head><meta charset="utf-8"><title>World write policy</title></head><body><h1>World write policy</h1><p>Owner authorization, complete validation and conditional replacement.</p><div hidden itemscope itemtype="https://pagelove.org/Trigger"><meta itemprop="resource" content="/worlds/prism-garden/definition.html"><meta itemprop="resource" content="/worlds/cloud-carnival/definition.html"><meta itemprop="resource" content="/worlds/electric-city/definition.html"><meta itemprop="resource" content="/worlds/crystal-caverns/definition.html"><meta itemprop="resource" content="/worlds/ember-foundry/definition.html"><meta itemprop="resource" content="/worlds/frost-observatory/definition.html"><meta itemprop="resource" content="/worlds/cosmic-reef/definition.html"><meta itemprop="resource" content="/worlds/prism-citadel/definition.html"><meta itemprop="resource" content="/worlds/sunken-archive/definition.html"><meta itemprop="resource" content="/worlds/aurora-passage/definition.html"><meta itemprop="resource" content="/worlds/clockwork-canopy/definition.html"><meta itemprop="resource" content="/worlds/mirage-dunes/definition.html"><meta itemprop="resource" content="/worlds/thunder-spire/definition.html"><meta itemprop="resource" content="/worlds/lunar-harbor/definition.html"><meta itemprop="resource" content="/worlds/event-horizon/definition.html"><meta itemprop="resource" content="/worlds/dawn-nexus/definition.html"><meta itemprop="method" content="PUT"><meta itemprop="method" content="POST"><meta itemprop="method" content="PATCH"><meta itemprop="method" content="DELETE"><div itemprop="action" itemscope itemtype="https://pagelove.org/JavaScript/Module"><script type="module" itemprop="source">// Independent document contract: no generated bundle or game imports.
+const THEMES=['garden','cloud','city','crystal','forge','ice','reef','citadel','archive','aurora','clockwork','dunes','storm','harbor','horizon','nexus'];
+const BASE_TYPES={normal:'urn:Brick:Normal',armor:'urn:Brick:Armor',explode:'urn:Brick:Explosive',switch:'urn:Brick:Switch'};
+const EFFECTS=['none','bonus','pulse','open-gates','slow-ball','power-up'];
+const escape=value=>String(value).replaceAll('&','&amp;').replaceAll('"','&quot;').replaceAll('<','&lt;').replaceAll('>','&gt;');
+const meta=(name,value)=>'<meta itemprop="'+name+'" content="'+escape(value)+'">';
+const range=(v,min,max,label,integer=false)=>{if(!Number.isFinite(v)||v<min||v>max||(integer&&!Number.isSafeInteger(v)))throw Error('Invalid '+label);return v;};
+const color=v=>{if(!/^#[a-f0-9]{6}$/i.test(v))throw Error('Use a six-digit hex color');return v;};
+const text=(v,max,label)=>{if(typeof v!=='string'||!v.trim()||v.length>max)throw Error('Invalid '+label);return v;};
+const props=element=>{const result=Object.create(null);for(const el of element.children){if(el.tagName.toLowerCase()!=='meta'||!el.hasAttribute('itemprop'))continue;const key=el.getAttribute('itemprop');if(Object.hasOwn(result,key))throw Error('Duplicate property: '+key);result[key]=el.getAttribute('content');}return result;};
+const children=(element,prop)=>[...element.children].filter(el=>el.getAttribute('itemprop')===prop&&el.hasAttribute('itemscope'));
+const number=(p,key,fallback)=>p[key]===undefined?fallback:Number(p[key]);
+const bool=(p,key)=>{if(p[key]!==undefined&&!['true','false'].includes(p[key]))throw Error('Invalid '+key);return p[key]==='true';};
