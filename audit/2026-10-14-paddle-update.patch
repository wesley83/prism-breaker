+const panel=`<aside id="update-lab" style="position:relative;z-index:20;padding:16px;background:#182b32;color:white;font:14px sans-serif"><strong>Local update verification only</strong><div>${[['b','Serve release B'],['a','Serve release A'],['broken','Break asset download'],['offline','Network unavailable'],['online','Restore network'],['check','Check for update'],['seed','Seed queued score'],['inspect','Inspect release and storage']].map(([id,label])=>'<button type="button" data-lab="'+id+'" style="margin:6px;padding:8px">'+label+'</button>').join('')}</div><pre id="lab-state" style="white-space:pre-wrap"></pre></aside><script type="module" src="/lab-diagnostics.js"></script>`;
