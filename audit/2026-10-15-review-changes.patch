+ const actualRoot=path.resolve(git(root,['rev-parse','--show-toplevel'])),expectedRoot=path.resolve(root),sameRoot=process.platform==='win32'?actualRoot.toLowerCase()===expectedRoot.toLowerCase():actualRoot===expectedRoot;
