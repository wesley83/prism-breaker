+function git(root,args){const r=spawnSync('git',['-c','safe.directory='+root.replaceAll('\\','/'),...args],{cwd:root,encoding:'utf8'});if(r.status!==0)throw Error('Release gate needs a readable Git checkout');return r.stdout.trim();}
