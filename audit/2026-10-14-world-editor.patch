new file mode 100644
index 0000000..af06f90
--- /dev/null
+++ b/public/editor-template.html
@@ -0,0 +1,16 @@
+<!doctype html><html><body><div id="editor-shell">
+<header class="workshop-header"><a href="/" aria-label="Prism Breaker start screen"><img src="/assets/prism-wordmark.svg" width="170" height="61" alt="Prism Breaker"></a><span>World workshop</span><a href="/">Back to start screen</a></header>
+<main class="workshop">
+<div class="workshop-intro"><div><p class="eyebrow">MAKE ROOM FOR A NEW IDEA</p><h1>Shape the next break.</h1><p>Arrange a world. Give its bricks a personality. Play what you make.</p></div><div class="world-picker"><label for="edit-world">World</label><select id="edit-world"></select><label for="edit-phase">Formation</label><select id="edit-phase"></select></div></div>
+<div class="workshop-actions"><div class="edit-tools" role="group" aria-label="Editing tool"><button id="tool-select" aria-pressed="true">Select & move</button><button id="tool-paint" aria-pressed="false">Add bricks</button><button id="tool-erase" aria-pressed="false">Erase</button></div><button id="undo" disabled>Undo</button><button id="redo" disabled>Redo</button><button id="preview" class="primary">Play this formation</button><button id="publish">Publish world</button></div>
+<p id="editor-status" class="status" role="status">Loading the world…</p>
+<div class="editor-layout"><section class="board-section" aria-labelledby="board-heading"><div class="board-heading"><h2 id="board-heading">The formation</h2><span id="brick-count"></span></div><div id="edit-board" class="edit-board" role="group" aria-label="World editing board"></div><p class="board-help">Select a brick to inspect it. Drag to move it; arrow keys move the selected brick. Add bricks paints the grid. Delete removes a selection.</p><div class="data-tools"><button id="show-html">Inspect HTML</button><button id="export">Download world</button><button id="import">Import world</button><input id="import-file" type="file" accept=".html,text/html" hidden><button id="reload">Reload published</button><button id="restore">Restore original</button></div></section>
+<aside class="inspector"><form id="brick-form"><div class="inspector-heading"><h2 id="inspector-title">Your brush</h2><button id="delete-brick" type="button" hidden>Delete brick</button></div><label for="brick-type">Brick type</label><select id="brick-type"><option value="normal">Regular</option><option value="armor">Armored</option><option value="explode">Explosive</option><option value="switch">Switch</option></select><div class="fields"><div><label for="brick-hp">Hits to break</label><select id="brick-hp"><option>1</option><option>2</option><option>3</option></select></div><div><label for="brick-color">Color</label><input id="brick-color" type="color" value="#b5ff6c"></div><div><label for="brick-x">X position</label><input id="brick-x" type="number" min="-8.9" max="8.9" step="0.01" value="0"></div><div><label for="brick-y">Y position</label><input id="brick-y" type="number" min="-7.5" max="10.5" step="0.01" value="9"></div></div><label class="check"><input id="brick-moving" type="checkbox"> Moving brick</label><button class="primary" type="submit" id="apply-brick">Set brush</button><p class="small">Specializations combine: an armored brick can also move, and a custom type can inherit either behavior.</p></form>
+<section class="type-builder"><h2>Invent a brick type</h2><p class="small">Give a new type a name and choose what happens when it breaks.</p><form id="type-form"><label for="type-name">Name</label><input id="type-name" maxlength="40" placeholder="Solar flare" required><label for="type-base">Starts as</label><select id="type-base"><option value="normal">Regular</option><option value="armor">Armored</option><option value="explode">Explosive</option><option value="switch">Switch</option></select><label for="type-effect">When destroyed</label><select id="type-effect"><option value="bonus">Award bonus points</option><option value="pulse">Damage nearby bricks</option><option value="open-gates">Open gates</option><option value="slow-ball">Slow the ball</option><option value="power-up">Drop a power-up</option><option value="none">Use the base behavior</option></select><div id="type-options"><label for="type-points">Bonus points</label><input id="type-points" type="number" min="0" max="1000" step="10" value="150"><label for="type-radius">Pulse radius</label><input id="type-radius" type="number" min="0.5" max="4" step="0.1" value="2.7"><label for="type-duration">Slow duration (seconds)</label><input id="type-duration" type="number" min="1" max="15" value="5"><label for="type-power">Power-up</label><select id="type-power"><option value="wide">Wide paddle</option><option value="multi">Multiball</option><option value="sticky">Sticky paddle</option><option value="laser">Laser paddle</option><option value="pierce">Piercing ball</option><option value="slow">Slow motion</option><option value="shield">Safety shield</option><option value="life">Extra life</option></select></div><button type="submit">Create type</button></form></section></aside></div>
+<p class="workshop-note">Drafts save automatically. Edited worlds are played in Practice; Adventure and Daily Challenge use the official formations.</p>
+</main>
+<dialog id="html-dialog"><button class="dialog-close" data-close="html-dialog" aria-label="Close HTML inspector">Close</button><h2>The world is the document.</h2><p>Rows, brick types, obstacles and behavior recipes are stored as HTML microdata.</p><textarea id="html-source" readonly spellcheck="false" aria-label="Structured world HTML"></textarea><button id="copy-html">Copy HTML</button><p id="html-status" role="status"></p></dialog>
+<dialog id="publish-dialog"><button class="dialog-close" data-close="publish-dialog" aria-label="Close publishing">Close</button><h2>Publish this world.</h2><p>Publishing updates the shared Practice layout. You need the host owner’s key.</p><form id="publish-form"><label for="owner-key">Host owner key</label><input id="owner-key" type="password" autocomplete="off" spellcheck="false" required><p class="small">Used for this request only. Never saved in the draft or on this page.</p><button id="confirm-publish" class="primary">Publish world</button></form><p id="publish-status" role="status"></p></dialog>
+<dialog id="preview-dialog" class="play-dialog"><div class="preview-top"><h2 id="preview-title">Practice preview</h2><span id="preview-score">Score 0 · Lives 3</span><button data-close="preview-dialog" aria-label="Close play preview">Close</button></div><div class="preview-arena"><canvas id="preview-canvas" tabindex="0" aria-label="Practice preview: move with arrow keys or pointer; Space launches"></canvas><button id="preview-launch" class="primary">Launch ball</button></div><div class="preview-bottom"><p id="preview-status" role="status">Preparing the 3D preview…</p><button id="restart-preview">Restart formation</button></div><details><summary>Brick events</summary><p class="small">Each collision dispatches a strike event on its matching HTML brick.</p><ol id="strike-events"></ol></details></dialog>
+<footer class="workshop-footer">Prism Breaker. Made to be played. <a href="https://pagelove.com/" target="_blank" rel="noopener" aria-label="Built on Pagelove (opens in a new tab)">Built on Pagelove</a></footer>
+</div><!-- editor-shell-end --></body></html>
